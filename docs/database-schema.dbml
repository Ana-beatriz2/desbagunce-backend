Project desbagunce {
  database_type: 'PostgreSQL'
}

Table houses {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  image_path varchar
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  email varchar [not null, unique]
  firebase_uid varchar [not null, unique]
  is_admin boolean [not null, default: false]
  house_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table items {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  notes text
  unit item_unit [not null, default: 'unit']
  status item_status [not null, default: 'in_stock']
  current_quantity numeric(10,3) [not null, default: 0]
  daily_consumption numeric(12,4) [note: 'units (or kg) used per day, learned from item_events']
  estimated_depletion_date date
  photo_path varchar
  house_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table item_events {
  id uuid [pk, default: `gen_random_uuid()`]
  type item_event_type [not null]
  quantity_change numeric(10,3) [note: 'signed delta; null when the quantity is untouched']
  quantity_after numeric(10,3)
  details jsonb
  item_id uuid [not null]
  house_id uuid [not null]
  user_id uuid [note: 'who did it; null until auth exists or if the user is deleted']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (item_id, created_at)
  }
}

Table tags {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar [not null]
  notes text
  house_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Table item_tags {
  id uuid [pk, default: `gen_random_uuid()`]
  item_id uuid [not null]
  tag_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (item_id, tag_id) [unique]
  }
}

Table invites {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar [not null]
  code varchar [not null, unique]
  status invite_status [not null, default: 'pending']
  expires_at timestamptz [not null]
  accepted_at timestamptz
  house_id uuid [not null]
  invited_by_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz
}

Enum invite_status {
  pending
  accepted
  expired
  canceled
}

Enum item_unit {
  unit
  kg
}

Enum item_status {
  in_stock
  running_low
  probably_out
  out_of_stock
}

Enum item_event_type {
  created
  purchased
  quantity_updated
  depleted
  confirmed_still_has
  edited
}

Ref: users.house_id > houses.id [delete: cascade]
Ref: items.house_id > houses.id [delete: cascade]
Ref: tags.house_id > houses.id [delete: cascade]
Ref: invites.house_id > houses.id [delete: cascade]
Ref: invites.invited_by_id > users.id [delete: cascade]
Ref: item_tags.item_id > items.id [delete: cascade]
Ref: item_tags.tag_id > tags.id [delete: cascade]
Ref: item_events.item_id > items.id [delete: cascade]
Ref: item_events.house_id > houses.id [delete: cascade]
Ref: item_events.user_id > users.id [delete: set null]
